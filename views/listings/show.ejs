<% layout("/layouts/boilerplate") %>
<body>    
    <div class="row mt-4">
        <div class="col-10 offset-1">
            <h3>Listing Details</h3>
            <div class="row row-cols-1 row-cols-md-2 g-4 mt-2">
                <div class="col sm-4">
                    <div class="card listing-card mb-3 pb-3" style="background-color: lavender;max-width: fit-content;">
                        <div class="row g-0">

                            <img src="<%= listing.image.url %>" alt="Python" class="card-img-top show-img">

                            <div class="card-body mx-2">
                                <h5 class="card-title"><b><%= listing.title %></b></h5>
                                <p class="card-text"><%= listing.description %></p>

                                <button type="button" class="btn btn-primary mb-3" data-bs-toggle="modal" data-bs-target="#videoModal">
                                    <i class="fa-solid fa-play"></i> Watch Course
                                </button>

                                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                                <div class="btns">
                                    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark edit-btn mx-2">Edit</a>
                            
                                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                        <button class="btn btn-dark">Delete</button>
                                    </form>
                                </div>
                                <% } %>

                            </div>

                        </div>
                    </div>
                </div>

                <div class="col sm-6">
                    <div class="row">
                        <div class="col-md-10">
                            <P style="font-size: larger;">
                                <b style="font-size: larger;"> About This Course :</b> <br>
                                Owned by <u><i><%= listing.owner.username %></i></u> <br>
                                <%= listing.description %>
                            </P>
                            <!-- <div class="capsule"><i>#<%= listing.tags[0] %></i></div> -->
                            <h5>Tags:</h5>
                            <div class="mb-3">
                                <% listing.tags.forEach(tag => { %>
                                    <span class="badge bg-dark me-2 mb-2 p-2" style="font-size: 0.85rem;"><%= tag %></span>
                                <% }) %>
                            </div>

                            <% if (listing.state === 'Live') { %>
                                <span class="badge bg-danger">
                                    <i class="fa-solid fa-broadcast-tower"></i> Live
                                </span>
                            <% } else { %>
                                <span class="badge bg-secondary">
                                    <i class="fa-solid fa-video"></i> Recorded
                                </span>
                            <% } %>
                            <!-- <div class="capsule"><i><%= listing.state %></i></div> -->
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <br> <br>

    <div class="col-10 offset-1">
        <div class="row row-cols-1 row-cols-md-2 g-4">
            <div class="col">
                <div class="card">
                    <div class="class-body">
                        <h5 class="card-title"> ABOUT THE INSTRUCTOR</h5>
                        <P class="card-text">
                        <div class="row ">
                            <h5 style="color: blue;text-decoration: underline;">@<%= listing.owner.username %></h5> <br>
                            <!-- <img src="images/profile.jpg" alt=""
                                style="border-radius: 50%;border-style: solid;border-color: gray;"> -->
                            <div class="col">
                                Developer and Lead Instructor <br>
                                4.7 Instructor Rating <br>
                                929,508 Reviews <br>
                                3,052,179 Student <br>
                                7 Courses <br> <br>
                            </div>
                            <p>
                                I'm Angela, I'm a developer with a passion for teaching. I'm the lead instructor at the
                                London App Brewery, London's leading Programming Bootcamp. I've helped hundreds of
                                thousands
                                of students learn to code and change their lives by becoming a developer. I've been
                                invited
                                by companies such as Twitter, Facebook and Google to teach their employees. <br>

                                My first foray into programming was when I was just 12 years old, wanting to build my
                                own
                                Space Invader game. Since then, I've made hundred of websites, apps and games. But most
                                importantly, I realised that my greatest passion is teaching. <br>

                                I spend most of my time researching how to make learning to code fun and make hard
                                concepts
                                easy to understand. I apply everything I discover into my bootcamp courses. In my
                                courses,
                                you'll find lots of geeky humour but also lots of explanations and animations to make
                                sure
                                everything is easy to understand. <br>

                                I'll be there for you every step of the way.
                            </p>
                        </div>
                        </P>

                    </div>
                </div>
            </div>
            <div class="col">
                <!-- Only show these admin controls to the course owner -->
                <% if(currUser && currUser._id.equals(listing.owner._id)) { %>
                    <div class="card border rounded-top border-primary" style="padding: 1rem !important;">
                        <div class="card-body">
                            <h5 class="card-title text-primary"><i class="fa-solid fa-lock-open"></i> INSTRUCTOR CONTROLS</h5>
                            <hr>
                            <h6 class="card-title mt-3">NOTES</h6>
                            <p class="card-text">Upload or link handwritten notes for this module.</p>
                            <button class="btn btn-outline-dark btn-sm">Add Notes</button>
                            
                            <h6 class="card-title mt-4">RECORDING</h6>
                            <p class="card-text">Update the video link for this course module.</p>
                            <!-- Changed to a link that goes to the Edit page -->
                            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark btn-sm">Edit Video Link</a>
                        </div>
                    </div>
                <% } else { %>
                    <!-- What normal students see -->
                    <div class="card border rounded" style="padding: 1rem !important;">
                        <div class="card-body">
                            <h5 class="card-title">COURSE MATERIALS</h5>
                            <p class="card-text">Instructor notes and resources will appear here once uploaded.</p>
                            <button class="btn btn-dark" disabled>Download Notes</button>
                        </div>
                    </div>
                <% } %>
            </div>
        </div>
        <br><br>

        <h3> RELATED COURSES</h3><br>
        <!-- <div class="d-flex justify-content-around">
                <div class="card mx-1" style="background-color: lavender;max-width: 33%;">
                    <img src="<%=  %>" class="card-img-top" alt="..." style="width: 100%;">
                    <div class="card-body mx-1">
                        <h5 class="card-title">ADVANCE PYTHON</h5>
                        <p class="card-text">By the course's culmination you will not only possess a profound
                            understanding of Python but also be equppied to face a multitude of programming
                            challanges.
                        </p>
                        <br><br>
                    </div>
                </div>
                <div class="card mx-1" style="background-color:lavender;max-width: 33%;transition: ease;">
                    <img src="<%=  %>" class="card-img-top" alt="..." style="width: 100%;">
                    <div class="card-body mx-1">
                        <h5 class="card-title">DATA ANALYSIS WITH PTYHON</h5>
                        <p class="card-text">Analysing data eith python is an essential skill for Data Scientist and
                            Data
                            Analysts.This course will
                            take you from the basics of data analysis with python to building and evaluating data
                            models.
                        </p>
                        <br> <br>
                    </div>
                </div>
                <div class="card mx-1" style="background-color: lavender;max-width: 38%;">
                    <img src="<%=  %>" class="card-img-top" alt="..." style="width: 100%;">
                    <div class="card-body  mx-1">
                        <h5 class="card-title">PYHTON FOR CYBER SECURITY</h5>
                        <p class="card-text">Python can help to automate tasks across the cyberattack life cycle for
                            both
                            attacker
                            and defender. 
                        </p> <br><br><br>
                    </div>
                </div>

        </div> -->

        
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let listing of allListings) { %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card" >
                        <img class="card-img-top" src="<%= listing.image.url %>" alt="Course_Image" style="height: 12.2rem;" />
                        <div class="card-img-overlay"></div>
            
                        <div class="card-body">
                            <p class="card-text">
                                <b><%= listing.title %></b> <br>
                                <%= listing.description %> <br>
                                <div class="capsule">
                                    #<%= listing.tags[0] %>
                                </div>
                                <div class="capsule">
                                    <i><%= listing.state %></i>
                                </div>
                                <i><%= listing.language %></i>
                            </p>
                        </div>
                    </div>
                </a>
                <% } %>
        </div>


        <hr>
        <div class="col-10 offset-1 mb-3">
            <% if(currUser) { %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                <!-- <div class="mb-3 mt-3">
                    <label for="Rating">Rating</label>
                    <input type="range", min="1", max="5", id="rating", name="review[rating]" class="form-range">
                </div> -->
                
                <div class="mb-3 mt-3">
                <label for="Rating">Rating</label>
                <fieldset class="starability-slot">
                    <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                    <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                    <label for="first-rate1" title="Terrible">1 star</label>
                    <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                    <label for="first-rate2" title="Not good">2 stars</label>
                    <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                    <label for="first-rate3" title="Average">3 stars</label>
                    <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                    <label for="first-rate4" title="Very good">4 stars</label>
                    <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                    <label for="first-rate5" title="Amazing">5 stars</label>
                  </fieldset>
                </div>

                <div class="mb-3 mt-3">
                    <label for="comment">Comment</label>
                    <textarea name="review[comment]" id="comment", cols="30", rows="5" class="form-control" required></textarea>
                    <div class="invalid-feedback">
                        Please add some commets for review
                    </div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
            <hr>
            <% } else { %>
                <div class="card p-3 my-3 bg-light border-0 rounded text-center">
                    <p class="mb-2 text-muted">Want to share your feedback about this course?</p>
                    <div>
                        <a href="/login" class="btn btn-sm btn-outline-primary px-3 mx-1">
                            <i class="fa-solid fa-right-to-bracket"></i> Login to Review
                        </a>
                        <a href="/signup" class="btn btn-sm btn-primary px-3 mx-1">
                            Sign Up
                        </a>
                    </div>
                </div>
                <hr>
            <% } %>


            <p><b>All Reviews</b></p>
    
            <div class="row">
                <% if (listing.reviews.length === 0) { %>
                    <div class="col-12 ms-3 mb-3 text-muted">
                        <p><i>No reviews yet. Be the first to add a review for this course!</i></p>
                    </div>
                <% } else { %>
                    <% for(review of listing.reviews) { %>
                        <div class="card col-5 ms-3 mb-3">
                            <div class="card-body mb-3">
                                <h5 class="card-title">@<%= review.author.username %></h5>
                                <p class="starability-result card-text" data-rating="<%= review.rating %>"></p>
                                <p class="card-text"><%= review.comment %></p>
                            </div>
                            <% if(currUser && currUser._id.equals(review.author._id)) { %>
                            <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" class="mb-3">
                                <button class="btn btn-sm btn-dark">Delete</button>
                            </form>
                            <% } %>
                        </div>
                    <% } %>
                <% } %>
            </div>
        </div>
    </div>

    <div class="modal fade" id="videoModal" tabindex="-1" aria-labelledby="videoModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content bg-dark text-white">
                
                <div class="modal-header border-secondary">
                    <h5 class="modal-title" id="videoModalLabel"><%= listing.title %> - Masterclass</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <div class="modal-body p-0">
                    <% 
                        let embedUrl = listing.videoUrl;
                        if (embedUrl && embedUrl.includes("watch?v=")) {
                            embedUrl = embedUrl.replace("watch?v=", "embed/");
                        }
                    %>
                    
                    <% if (embedUrl) { %>
                        <div class="ratio ratio-16x9">
                            <iframe src="<%= embedUrl %>" title="Course Video" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                        </div>
                    <% } else { %>
                        <div class="p-5 text-center">
                            <p>Video content is currently unavailable.</p>
                        </div>
                    <% } %>
                </div>
                
            </div>
        </div>
    </div>
</body>